        "name": "岑参",
        "years": "715—770",
        "role": "边塞诗人",
        "relation": "诗友",
        "tone": "同道",
        "depth": 2,
        "note": "天宝十一载，杜甫与高适、岑参、薛据、储光羲同登长安慈恩寺塔，各有诗作。"
      },
      {
        "id": "xue-ju",
        "name": "薛据",
        "years": "生卒年不详",
        "role": "诗人",
        "relation": "诗友",
        "tone": "同道",
        "depth": 3,
        "note": "与杜甫、高适、岑参等同登慈恩寺塔赋诗，杜甫《同诸公登慈恩寺塔》记此游。"
      },
      {
        "id": "chu-guangxi",
        "name": "储光羲",
        "years": "706—763",
        "role": "诗人",
        "relation": "诗友",
        "tone": "同道",
        "depth": 3,
        "note": "同登慈恩寺塔的诗人之一；杜甫在《同诸公登慈恩寺塔》中与他同题赋诗。"
      },
      {
        "id": "fang-guan",
        "name": "房琯",
        "years": "697—763",
        "role": "宰相",
        "relation": "知遇",
        "tone": "同僚",
        "depth": 2,
        "note": "安史之乱中任宰相；杜甫因上疏救房琯触怒肃宗，被贬华州司功参军。"
      }
    ],
    "sources": [
