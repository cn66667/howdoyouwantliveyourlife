        "years": "704—765",
        "role": "边塞诗人",
        "relation": "诗友",
        "tone": "同道",
        "note": "744年与李白、杜甫同游梁宋。安史之乱后高适镇蜀，杜甫在成都与他仍有诗札往还。",
        "depth": 2
      },
      {
        "id": "yan-wu",
        "name": "严武",
        "years": "726—765",
        "role": "剑南节度使",
        "relation": "恩主",
        "tone": "同僚",
        "note": "严武镇成都，荐杜甫为节度参谋、检校工部员外郎。杜甫在草堂时期多倚严武照拂。",
        "depth": 2
      },
      {
        "id": "zheng-qian",
        "name": "郑虔",
        "years": "691—759",
        "role": "学者、画家",
        "relation": "旧友",
        "tone": "知己",
        "note": "长安旧交，工诗善画。郑虔晚年贬台州司户，杜甫作《送郑十八虔贬台州司户》相送。",
        "depth": 1
      },
      {
        "id": "li-guinian",
        "name": "李龟年",
        "years": "生卒年不详",
        "role": "宫廷乐师",
        "relation": "知音",
        "tone": "同道",
        "note": "开元年间名动一时的乐师。大历五年（770）杜甫在潭州与他重逢，作《江南逢李龟年》。",
        "depth": 3
      },
      {
        "id": "wei-ji",
        "name": "韦济",
        "years": "687—？",
        "role": "尚书左丞",
        "relation": "前辈",
        "tone": "师友",
        "note": "韦济任尚书左丞时，杜甫献《奉赠韦左丞丈二十二韵》，诗中“读书破万卷，下笔如有神”即出此篇。",
        "depth": 3
      },
      {
        "id": "li-yong",
        "name": "李邕",
        "years": "678—747",
        "role": "书法家",
        "relation": "前辈",
        "tone": "师友",
        "depth": 3,
        "note": "杜甫在《奉赠韦左丞丈二十二韵》中写“李邕求识面”，记其盛名与前辈风仪。"
      },
      {
        "id": "meng-haoran",
        "name": "孟浩然",
        "years": "689—740",
        "role": "诗人",
        "relation": "前辈",
        "tone": "师友",
        "depth": 3,
        "note": "杜甫在《解闷十二首》中称“复忆襄阳孟浩然，清诗句句尽堪传”，推重其清诗。"
      },
      {
        "id": "he-zhizhang",
        "name": "贺知章",
        "years": "659—744",
        "role": "诗人、书法家",
        "relation": "酒友",
        "tone": "同道",
        "depth": 3,
        "note": "杜甫《饮中八仙歌》写贺知章醉后骑马、落井而眠，是长安酒席上的前辈名士。"
      },
      {
        "id": "zhang-xu",
        "name": "张旭",
        "years": "生卒年不详",
        "role": "书法家",
        "relation": "酒友",
        "tone": "同道",
        "depth": 3,
        "note": "杜甫《饮中八仙歌》写张旭“脱帽露顶王公前，挥毫落纸如云烟”，记其狂草与酒兴。"
      },
      {
        "id": "su-yuanming",
        "name": "苏源明",
        "years": "？—764",
        "role": "文学家",
        "relation": "挚友",
        "tone": "知己",
        "depth": 1,
        "note": "杜甫早年在长安的挚友，安史之乱后仍有诗札往还，杜甫诗中多次念及旧交。"
      },
      {
